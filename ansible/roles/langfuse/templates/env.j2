# LangFuse v3 環境変数（Ansible管理）

# ===== セキュリティ =====
NEXTAUTH_SECRET={{ langfuse_vault_nextauth_secret }}
SALT={{ langfuse_vault_salt }}
ENCRYPTION_KEY={{ langfuse_vault_encryption_key }}

# ===== アプリケーション =====
NEXTAUTH_URL={{ langfuse_nextauth_url }}
HOSTNAME=0.0.0.0
PORT={{ langfuse_web_port }}

# ===== PostgreSQL =====
{# URL に埋め込むパスワードは全部エンコードする（Jinja の urlencode は / を残すので %2F に置き換える）。
   使えない値（$ や引用符など）は tasks/secrets_check.yml が止める。Jinja のコメントなので .env には出ない
   （.env に出すとファイルが変わり、ハンドラが Langfuse の全コンテナを再起動する） #}
DATABASE_URL=postgresql://{{ langfuse_db_username }}:{{ langfuse_vault_db_password | urlencode | replace('/', '%2F') }}@langfuse-database:5432/{{ langfuse_db_database_name }}
DIRECT_URL=postgresql://{{ langfuse_db_username }}:{{ langfuse_vault_db_password | urlencode | replace('/', '%2F') }}@langfuse-database:5432/{{ langfuse_db_database_name }}

# ===== ClickHouse =====
CLICKHOUSE_MIGRATION_URL=clickhouse://langfuse-clickhouse:9000/{{ langfuse_clickhouse_database }}
CLICKHOUSE_URL=http://langfuse-clickhouse:8123
CLICKHOUSE_USER={{ langfuse_clickhouse_user }}
CLICKHOUSE_PASSWORD={{ langfuse_vault_clickhouse_password }}
CLICKHOUSE_CLUSTER_ENABLED=false

# ===== Redis =====
REDIS_CONNECTION_STRING=redis://:{{ langfuse_vault_redis_password | urlencode | replace('/', '%2F') }}@langfuse-redis:6379

# ===== AWS S3（用途別に設定が必要） =====
LANGFUSE_S3_EVENT_UPLOAD_BUCKET={{ langfuse_s3_event_bucket }}
LANGFUSE_S3_EVENT_UPLOAD_REGION={{ langfuse_s3_region }}
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID={{ langfuse_vault_s3_access_key_id }}
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY={{ langfuse_vault_s3_secret_access_key }}
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET={{ langfuse_s3_media_bucket }}
LANGFUSE_S3_MEDIA_UPLOAD_REGION={{ langfuse_s3_region }}
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID={{ langfuse_vault_s3_access_key_id }}
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY={{ langfuse_vault_s3_secret_access_key }}
LANGFUSE_S3_BATCH_EXPORT_BUCKET={{ langfuse_s3_export_bucket }}
LANGFUSE_S3_BATCH_EXPORT_REGION={{ langfuse_s3_region }}
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID={{ langfuse_vault_s3_access_key_id }}
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY={{ langfuse_vault_s3_secret_access_key }}

# ===== OTLP =====
LANGFUSE_ENABLE_OTEL_ENDPOINT=true
