<!-- ClickHouse システムテーブル TTL（Ansible 管理） -->
<!-- 無制限に肥大化するシステムテーブルに TTL を設定 -->
<clickhouse>
    <query_log>
        <ttl>event_date + INTERVAL {{ langfuse_clickhouse_system_log_ttl_days }} DAY</ttl>
    </query_log>
    <query_thread_log>
        <ttl>event_date + INTERVAL {{ langfuse_clickhouse_system_log_ttl_days }} DAY</ttl>
    </query_thread_log>
    <trace_log>
        <ttl>event_date + INTERVAL {{ langfuse_clickhouse_system_log_ttl_days }} DAY</ttl>
    </trace_log>
    <part_log>
        <ttl>event_date + INTERVAL {{ langfuse_clickhouse_system_log_ttl_days }} DAY</ttl>
    </part_log>
    <metric_log>
        <ttl>event_date + INTERVAL {{ langfuse_clickhouse_system_log_ttl_days }} DAY</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL {{ langfuse_clickhouse_system_log_ttl_days }} DAY</ttl>
    </asynchronous_metric_log>
    <text_log>
        <ttl>event_date + INTERVAL {{ langfuse_clickhouse_system_log_ttl_days }} DAY</ttl>
    </text_log>
    <background_schedule_pool_log>
        <ttl>event_date + INTERVAL {{ langfuse_clickhouse_system_log_ttl_days }} DAY</ttl>
    </background_schedule_pool_log>
    <query_metric_log>
        <ttl>event_date + INTERVAL {{ langfuse_clickhouse_system_log_ttl_days }} DAY</ttl>
    </query_metric_log>
    <error_log>
        <ttl>event_date + INTERVAL {{ langfuse_clickhouse_system_log_ttl_days }} DAY</ttl>
    </error_log>
    <query_views_log>
        <ttl>event_date + INTERVAL {{ langfuse_clickhouse_system_log_ttl_days }} DAY</ttl>
    </query_views_log>
    <!-- opentelemetry_span_log は既定の設定が engine を直接指定していて ttl を併用できないので、記録そのものを止める（Langfuse は使わない） -->
    <opentelemetry_span_log remove="1"/>
</clickhouse>
