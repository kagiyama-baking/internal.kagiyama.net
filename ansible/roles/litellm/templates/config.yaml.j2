# LiteLLM Proxy 設定
# モデルは Web UI（/ui）から追加・管理する（STORE_MODEL_IN_DB=True）

model_list: []

litellm_settings:
  # プロバイダー非対応パラメータを自動除去
  drop_params: true
  set_verbose: false
  num_retries: 2
  request_timeout: 120
  # Langfuse へトレース送信
  success_callback: ["langfuse"]
  failure_callback: ["langfuse"]

general_settings:
  # 管理画面への環境変数の資格情報によるログインを止める（UI_PASSWORD が無いと master key がそのまま管理者のパスワードになる）。
  # 管理画面には DB のパスワード付き管理者で入る。master key による API の利用は変わらない。
  # 締め出されたら master key で API から管理でき、この行を外して再起動すれば戻る（README の「運用上の注意」）
  disable_env_credential_login: true
  master_key: "os.environ/LITELLM_MASTER_KEY"
