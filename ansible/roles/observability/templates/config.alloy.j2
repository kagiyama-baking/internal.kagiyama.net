// Grafana Alloy のログ収集設定（Promtail から移行）。
// Loki に入るラベル（job / service_name / container_name / filename）は Promtail のときと同じにしてある。
// アラート（grafana/alerting/rules.yml.j2）が {job="syslog"} を使うので、ラベルを変えないこと。

// Docker コンテナのログ: Docker API で全コンテナを検出し、API 経由で読む（/var/lib/docker のマウントは不要）
discovery.docker "docker" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}

discovery.relabel "docker" {
  targets = discovery.docker.docker.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  rule {
    target_label = "job"
    replacement  = "docker"
  }

  // 最後に置く: loki.source.docker は読み出し位置を「コンテナ ID ＋ 対象のラベル一式」で保存する。
  // IP（__address__）やネットワークのラベルを残すと、再起動で IP が変わったコンテナを位置の無い新しい対象として
  // 先頭から読み直す。コンテナ ID（loki.source.docker が使う）と Loki に送る 3 つだけを残す（__ で始まるものは送られない）
  rule {
    action = "labelkeep"
    regex  = "__meta_docker_container_id|container_name|job|service_name"
  }
}

loki.source.docker "docker" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker.output
  forward_to = [loki.write.default.receiver]
}

// ホストの syslog と auth.log。読み出し位置は --storage.path（/data、alloy_data ボリューム）の positions に保存する。
// tail_from_end は、位置が無いか読めないとき（ボリュームを失ったときなど）にファイルを開く最初の 1 回だけ効く保険:
// ファイル全体を今の時刻で読み直さず、末尾から読む（読み直すと古い "Backup failed" 行が直近のものとして入り、
// アラートが誤発火する）。動作中のローテーションでは新しいファイルを先頭から読むので、行は欠けない。
loki.source.file "syslog" {
  targets = [{
    __path__     = "/var/log/syslog",
    job          = "syslog",
    service_name = "syslog",
  }]
  forward_to = [loki.write.default.receiver]

  file_match {
    enabled = true
  }
  tail_from_end = true
}

loki.source.file "authlog" {
  targets = [{
    __path__     = "/var/log/auth.log",
    job          = "authlog",
    service_name = "authlog",
  }]
  forward_to = [loki.write.default.receiver]

  file_match {
    enabled = true
  }
  tail_from_end = true
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
