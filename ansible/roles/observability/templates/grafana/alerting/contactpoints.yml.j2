apiVersion: 1

contactPoints:
  - orgId: 1
    name: slack
    receivers:
      - uid: slack-webhook
        type: slack
{# {% raw %} は直前の行の末尾に、{% endraw %} は単独の行に置く。Ansible の trim_blocks は {% endraw %} の後ろの改行を消す
   (行末に置くと次の行が連結される)一方、{% raw %} の後ろの改行は残す(単独の行に置くと空行が入る)。 #}
        settings:{% raw %}
          # URL は grafana.env の環境変数から Grafana が起動時に展開する（このファイルは 0644 で秘密値を置かない）
          url: "${SLACK_WEBHOOK_URL}"
          title: >-
            [{{ .Status | toUpper }}] {{ .GroupLabels.alertname }}
          text: >-
            {{ range .Alerts }}
            *{{ .Labels.alertname }}*
            {{ .Annotations.summary }}
            {{ end }}
{% endraw %}
